{
  "name": "crewreview-monorepo",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun apps/cli/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:l10n": "bun scripts/check-l10n.ts",
    "check:changelog": "bun scripts/check-changelog.ts",
    "check": "bun run typecheck && bun test && bun run check:l10n && bun run check:changelog",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "7.0.2"
  }
}
