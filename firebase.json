{
  "hosting": [
    {
      "target": "crewreview",
      "public": "site/public",
      "predeploy": ["bun scripts/build-site.ts"],
      "cleanUrls": true,
      "trailingSlash": true,
      "ignore": ["**/.*"],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
        },
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://gc.zgo.at; connect-src 'self' https://crewreview.goatcounter.com; img-src 'self' data: https://crewreview.goatcounter.com; base-uri 'none'; frame-ancestors 'none'" }
          ]
        }
      ]
    },
    {
      "target": "crewreview-legacy",
      "public": "hosting-redirect",
      "redirects": [
        { "source": "/", "destination": "https://crewreview.pururucos.com.br/", "type": 301 },
        { "source": "/:path*", "destination": "https://crewreview.pururucos.com.br/:path", "type": 301 }
      ]
    }
  ]
}
