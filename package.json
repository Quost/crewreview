{
  "name": "crewreview-monorepo",
  "version": "0.14.2",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun apps/cli/src/main.ts",
    "test": "bun test --timeout 60000",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "check:l10n": "bun scripts/check-l10n.ts",
    "check:changelog": "bun scripts/check-changelog.ts",
    "check": "bun run typecheck && bun run test && bun run check:l10n && bun run check:changelog && bun run check:versions && bun run site",
    "build": "bun scripts/build.ts",
    "build:all": "bun scripts/build.ts --all",
    "site": "bun scripts/build-site.ts",
    "site:indexnow": "bun scripts/indexnow.ts",
    "check:versions": "bun scripts/check-versions.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "7.0.2"
  }
}
